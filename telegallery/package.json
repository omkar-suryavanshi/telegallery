{
  "name": "telegallery",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run prisma:generate --workspace backend && concurrently -n backend,frontend -c blue,magenta \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend"
    
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "husky": "^9.1.6"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "bufferutil@4.1.0": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.28.1": true,
    "prisma@5.22.0": true,
    "sharp@0.33.5": true,
    "unrs-resolver@1.12.2": true,
    "utf-8-validate@5.0.10": true
  }
}
